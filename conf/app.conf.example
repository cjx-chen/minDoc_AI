ai_code_wiki_repo_add_api_key=""
ai_code_wiki_repo_add_auth_header=Authorization
ai_code_wiki_repo_add_auth_prefix=Bearer 
ai_code_wiki_repo_add_body=

; Code Wiki ordinary API configuration. Prefer these keys; legacy ai_code_wiki_* keys remain compatible.
code_wiki_endpoint=http://22.10.124.20:8001/chat/completions/stream
code_wiki_api_key=""
code_wiki_auth_header=Authorization
code_wiki_auth_prefix=Bearer 
code_wiki_repo_url=D:\JavaProject\wiki\IN0800
code_wiki_type=local
code_wiki_provider=openai
code_wiki_model=Cot-quick
code_wiki_language=zh
code_wiki_repo_list_endpoint=
code_wiki_repo_list_method=GET
code_wiki_repo_list_api_key=""
code_wiki_repo_list_auth_header=Authorization
code_wiki_repo_list_auth_prefix=Bearer 
code_wiki_repo_list_body=
code_wiki_repo_add_endpoint=
code_wiki_repo_add_method=POST
code_wiki_repo_add_api_key=""
